# Runtime identity
MANORECK_ENVIRONMENT=local
MANORECK_LOG_LEVEL=debug
MANORECK_HTTP_ADDRESS=:8080
MANORECK_HTTP_SHUTDOWN_TIMEOUT_SECONDS=10
MANORECK_READINESS_TIMEOUT_SECONDS=2

# Authoritative and asynchronous infrastructure
MANORECK_DATABASE_URL=postgres://manoreck:manoreck_local@postgres:5432/manoreck?sslmode=disable
MANORECK_DATABASE_MAX_CONNECTIONS=10
MANORECK_DATABASE_MIN_CONNECTIONS=1
MANORECK_NATS_URL=nats://nats:4222
MANORECK_OUTBOX_POLL_MILLISECONDS=250
MANORECK_OUTBOX_LEASE_SECONDS=30
MANORECK_OUTBOX_BATCH_SIZE=100
MANORECK_OUTBOX_MAX_ATTEMPTS=8
MANORECK_OUTBOX_BASE_BACKOFF_SECONDS=1
MANORECK_OUTBOX_MAX_BACKOFF_SECONDS=300
MANORECK_REDIS_URL=redis://redis:6379/0
MANORECK_REDIS_KEY_PREFIX=manoreck

# Optional host ports used by Docker Compose. Container-to-container addresses
# remain the stable service names above.
MANORECK_POSTGRES_HOST_PORT=5432
MANORECK_NATS_HOST_PORT=4222
MANORECK_NATS_MONITOR_HOST_PORT=8222
MANORECK_REDIS_HOST_PORT=6379
MANORECK_SEAWEEDFS_HOST_PORT=8333
MANORECK_KRATOS_PUBLIC_HOST_PORT=4433
MANORECK_KRATOS_ADMIN_HOST_PORT=4434
MANORECK_BACKEND_HOST_PORT=8080
MANORECK_FRONTEND_HOST_PORT=3000

# Object storage
MANORECK_OBJECT_STORAGE_ENDPOINT=http://seaweedfs:8333
MANORECK_OBJECT_STORAGE_BUCKET=manoreck-local
MANORECK_OBJECT_STORAGE_ACCESS_KEY=local-access-key
MANORECK_OBJECT_STORAGE_SECRET_KEY=local-secret-key

# Authentication integration
MANORECK_KRATOS_PUBLIC_URL=http://kratos:4433
MANORECK_KRATOS_ADMIN_URL=http://kratos:4434

# Frontend. NEXT_PUBLIC values are embedded into browser-visible output.
NEXT_PUBLIC_MANORECK_API_BASE_URL=http://localhost:8080
MANORECK_BACKEND_INTERNAL_URL=http://backend:8080
